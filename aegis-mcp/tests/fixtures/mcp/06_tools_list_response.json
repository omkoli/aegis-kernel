{
  "jsonrpc": "2.0",
  "id": 2,
  "result": {
    "tools": [
      {
        "name": "read_file",
        "description": "Read the contents of a file at the given path",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path to the file to read"
            }
          },
          "required": ["path"]
        }
      },
      {
        "name": "get_time",
        "description": "Get the current server time",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "search_files",
        "description": "Search for files matching a pattern",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Glob pattern to match"
            },
            "directory": {
              "type": "string",
              "description": "Directory to search in"
            }
          },
          "required": ["pattern"]
        }
      }
    ]
  }
}
